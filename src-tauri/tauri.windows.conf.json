{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "node src-tauri/installer-theme/build.mjs && pnpm build"
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer-theme/generated/sidebar.bmp",
        "installerHooks": "installer-theme/generated/theme.nsh",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "German",
          "Korean",
          "French"
        ],
        "customLanguageFiles": {
          "English": "installer-theme/generated/English.nsh",
          "SimpChinese": "installer-theme/generated/SimpChinese.nsh",
          "TradChinese": "installer-theme/generated/TradChinese.nsh",
          "Japanese": "installer-theme/generated/Japanese.nsh",
          "German": "installer-theme/generated/German.nsh",
          "Korean": "installer-theme/generated/Korean.nsh",
          "French": "installer-theme/generated/French.nsh"
        },
        "displayLanguageSelector": false
      }
    }
  }
}
